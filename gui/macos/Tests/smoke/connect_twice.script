# The same database connected twice in one window: two entries (after the
# window's start form) over one open connection; closing one with a
# transaction open asks nothing (the other still holds it), closing the
# last asks; a second window starts with a form of its own
connect $LACE_SMOKE_DB
connect $LACE_SMOKE_DB
expect-entries 3
expect-entry connection
expect-title t.sqlite
expect-open-connections 1
new-window
expect-windows 2
window 2
expect-entries 1
expect-entry form
window 1
query BEGIN
run
expect-badge 2
close-connection
expect-no-alert
expect-entries 2
expect-open-connections 1
close-connection
expect-alert transaction
answer-alert cancel
expect-entries 2
close-connection
answer-alert go
expect-entries 1
expect-open-connections 0
quit
