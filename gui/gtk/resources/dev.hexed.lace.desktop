[Desktop Entry]
Name=Lace
GenericName=Database Viewer
Comment=View and edit SQLite, PostgreSQL, MySQL and MariaDB databases
Exec=lace-gtk %U
Icon=dev.hexed.lace
Terminal=false
Type=Application
Categories=Development;Database;GTK;
Keywords=sql;database;sqlite;postgres;mysql;mariadb;
MimeType=application/vnd.sqlite3;application/x-sqlite3;
StartupNotify=true
